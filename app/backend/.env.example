# HTTP server port
PORT=8080

# Runtime environment: dev | prod
ENV=dev

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_backend?sslmode=disable

# Secret used to sign/verify access tokens (keep separate from refresh secret)
JWT_ACCESS_SECRET=change-me-access-secret

# Secret used to sign/verify refresh tokens
JWT_REFRESH_SECRET=change-me-refresh-secret

# Access token lifetime (Go duration format)
JWT_ACCESS_TTL=15m

# Refresh token lifetime (Go duration format)
JWT_REFRESH_TTL=168h

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Comma-separated origins allowed to call this API from a browser (the web build of app/)
CORS_ALLOWED_ORIGINS=http://localhost:8081
