# Managed by Ansible (roles/kubeadm_control_plane). Holds a join token and a certificate key; deleted after the join.
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    token: "{{ join_token }}"
    apiServerEndpoint: "{{ haproxy_vip }}:{{ kube_apiserver_port }}"
    caCertHashes:
      - "sha256:{{ join_ca_hash }}"
controlPlane:
  localAPIEndpoint:
    advertiseAddress: {{ ansible_host }}
    bindPort: {{ kube_apiserver_port }}
  certificateKey: "{{ join_certificate_key }}"
nodeRegistration:
  name: {{ inventory_hostname }}
patches:
  directory: {{ kubeadm_patches_dir }}
