# Managed by Ansible (roles/haproxy_keepalived). Do not edit on the node.
global
    log /dev/log local0
    maxconn 4096
    user haproxy
    group haproxy

defaults
    log global
    mode tcp
    option tcplog
    timeout connect 5s
    timeout client 1m
    timeout server 1m

frontend kube_apiserver
    bind {{ haproxy_vip }}:{{ haproxy_frontend_port }}
    default_backend kube_apiserver

backend kube_apiserver
    balance roundrobin
    option tcp-check
    default-server inter 3s fall 3 rise 2
{% for host in groups['control_plane'] %}
    server {{ host }} {{ hostvars[host].ansible_host }}:{{ kube_apiserver_port }} check
{% endfor %}
