# Managed by Ansible (roles/haproxy_keepalived). Contains the VRRP secret; mode 0600.
global_defs {
    router_id {{ inventory_hostname }}
    script_user root
    enable_script_security
}

vrrp_script chk_haproxy {
    script "/usr/bin/pidof haproxy"
    interval 2
    fall 2
    rise 2
    weight -20
}

vrrp_instance athena_api {
    state BACKUP
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_router_id }}
    priority {{ keepalived_priority }}
    nopreempt
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for host in groups['control_plane'] if host != inventory_hostname %}
        {{ hostvars[host].ansible_host }}
{% endfor %}
    }
    authentication {
        auth_type PASS
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ haproxy_vip }}/{{ keepalived_vip_prefix }} dev {{ keepalived_interface }}
    }
    track_script {
        chk_haproxy
    }
}
