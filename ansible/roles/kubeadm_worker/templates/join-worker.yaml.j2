# Managed by Ansible (roles/kubeadm_worker). Holds a join token; deleted after the join.
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    token: "{{ join_token }}"
    apiServerEndpoint: "{{ haproxy_vip }}:{{ kube_apiserver_port }}"
    caCertHashes:
      - "sha256:{{ join_ca_hash }}"
nodeRegistration:
  name: {{ inventory_hostname }}
