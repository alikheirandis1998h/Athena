# Managed by Ansible (roles/cilium). Cilium replaces kube-proxy and reaches the API server through the HAProxy VIP.
kubeProxyReplacement: "true"
k8sServiceHost: {{ haproxy_vip }}
k8sServicePort: {{ kube_apiserver_port }}
devices: {{ cilium_device }}
ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv4PodCIDRList:
      - {{ kubernetes_pod_subnet }}
    clusterPoolIPv4MaskSize: 24
routingMode: tunnel
tunnelProtocol: vxlan
# Images come from the registry in group_vars. Digests are off because the mirror tags are the pins.
image:
  repository: {{ registry_url }}/cilium/cilium
  tag: v{{ cilium_chart_version }}
  useDigest: false
envoy:
  image:
    repository: {{ registry_url }}/cilium/cilium-envoy
    tag: {{ cilium_envoy_image_tag }}
    useDigest: false
operator:
  image:
    repository: {{ registry_url }}/cilium/operator
    tag: v{{ cilium_chart_version }}
    suffix: ""
    useDigest: false
certgen:
  image:
    repository: {{ registry_url }}/cilium/certgen
    tag: {{ cilium_certgen_image_tag }}
    useDigest: false
