apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: {{ app_namespace }}
type: Opaque
stringData:
  postgres-password: "{{ app_postgres_password }}"
  database-url: "postgres://base:{{ app_postgres_password }}@app-postgres:5432/base?sslmode=disable"
  jwt-access-secret: "{{ app_jwt_access_secret }}"
  jwt-refresh-secret: "{{ app_jwt_refresh_secret }}"
